VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Bank transfer details shown on the payment page.
# Never commit the real values. Set them in your host's environment settings.
VITE_BANK_NAME=Example Bank
VITE_BANK_ACCOUNT_NAME=Ashake Alase (placeholder)

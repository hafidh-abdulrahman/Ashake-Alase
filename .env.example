# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key for Paystack API routes.
# Never add this to a VITE_ variable or frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Business contact details
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_INSTAGRAM=
VITE_CONTACT_TIKTOK=

# Paystack test mode
# Safe to expose in the browser. Do not use the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Server-only Paystack key. Configure this in Vercel/server environment settings.
# Never expose it through VITE_ or frontend code.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
